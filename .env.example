# Copie este arquivo para .env e ajuste os valores antes de subir o ambiente.
# O arquivo .env fica apenas na máquina local e não deve ser versionado.
# O Docker Compose lê estas variáveis e as repassa aos containers.

# Nome do banco criado na primeira inicialização do volume.
POSTGRES_DB=raizes

# Usuário administrador criado na primeira inicialização do volume.
POSTGRES_USER=raizes_usuario

# Senha desse usuário. Troque o valor antes de usar o ambiente.
POSTGRES_PASSWORD=altere-esta-senha

# Porta do PostgreSQL publicada na máquina local. Dentro da rede Docker a porta continua 5432.
POSTGRES_PORT=5432

# Porta da API publicada na máquina local. O processo dentro do container escuta em 8080.
API_PORT=8080

# Chave HMAC-SHA256 do JWT. Precisa ter pelo menos 32 bytes. Troque antes de usar.
JWT_SECRET=troque-esta-chave-por-outra-com-32-bytes

# Tempo de validade do token, em segundos.
JWT_EXPIRATION_SECONDS=3600
